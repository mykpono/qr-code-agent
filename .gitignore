node_modules/
dist/
.astro/
.env
.DS_Store
.vercel/
.vercel

# Translation working directory — extracted chunks and in-flight translations.
# Only the finished bundle in src/content/i18n/ is committed.
.i18n-work/

# AXME knowledge base. The canonical store for this project is one level up, at
# "QR Code Agent/.axme-code/", OUTSIDE this repo — so none of it is version
# controlled. A session started with its cwd here (rather than at the project
# root) creates a second, competing store at this path with its own D-001…
# numbering, which silently shadows the real one. Ignore it so it can never be
# committed, and move any entries it collects up to the parent.
.axme-code/

# OG font staging — woff2 decompressed to ttf for the rasterizer.
.og-fonts/

# public/assets/og.png is COMMITTED, deliberately. It is a Chromium screenshot
# of the real generator widget (scripts/gen-og.mjs) and Vercel's build container
# has no browser, so it cannot be regenerated at deploy time the way logo.png
# is. Refresh it with `npm run build && npm run og` after changing the widget.

# Playwright e2e output (npm run test:e2e)
test-results/
playwright-report/
/blob-report/
.playwright/

# Google service-account keys — NEVER commit
*service-account*.json
gsc-key*.json
*.gcp-key.json
