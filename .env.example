# Client-safe public IDs (set these in Vercel → Project → Environment Variables)
PUBLIC_UMAMI_WEBSITE_ID=
# Optional override; default /stats/script.js is proxied to self-hosted Umami via vercel.json
PUBLIC_UMAMI_SRC=/stats/script.js
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_STRIPE_SUPPORT_URL=https://buy.stripe.com/cNi9AU4zI3w31Fw2KudUY01
# Google Apps Script web-app URL that mails the generator's feedback strip to
# info@myxys.com. Source + deploy steps: scripts/feedback-relay.gs. Ends in
# /exec. Public by design (it only reaches that one inbox). The feedback strip
# does not render at all while this is unset.
PUBLIC_FEEDBACK_ENDPOINT=
